# Copy this file to .env and fill in your real API key.
# .env is not loaded automatically unless you export these vars yourself
# or add python-dotenv + load_dotenv() at app startup.
 
# Which LLM provider to use. Currently only "anthropic" is implemented
# in app/common/llm_client.py.
LLM_PROVIDER=anthropic
 
# API key for the configured provider. Required - without it, parsing
# falls back to "needs clarification" and explanations fall back to the
# raw rule-engine message/refusal text.
LLM_API_KEY=your-api-key-here
 
# Model name to use for completions.
LLM_MODEL=claude-haiku-4-5
LLM_API_KEY=your-api-key-here
